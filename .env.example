# Porta do WordPress no computador
WORDPRESS_PORT=8080

# Credenciais exclusivas do ambiente local
WORDPRESS_DB_NAME=coursepress
WORDPRESS_DB_USER=coursepress
WORDPRESS_DB_PASSWORD=coursepress_local_change_me
MARIADB_ROOT_PASSWORD=root_local_change_me

# 1 ativa o modo de depuração local; 0 desativa
WORDPRESS_DEBUG=1
